<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
             xmlns:local="clr-namespace:Resume.Maui.Shared.Controls.Standalones"
             x:DataType="local:LocalizePicker"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resume.Maui.Shared.Controls.Standalones.LocalizePicker">
    
    <ContentView.Resources>
        <ControlTemplate x:Key="comboControlTemp">
            <ImageButton Source="localizeicon.svg"
                         
                         Clicked="ImageButton_Clicked"/>
        </ControlTemplate>
    </ContentView.Resources>
    <telerik:RadComboBox x:Name="comboBox"
                         ControlTemplate="{StaticResource comboControlTemp}"
                         IsDropDownClosedOnSelection="True"
                         IsEditable="True"
                         ItemsSource="{Binding LocalizeItems}">
        <telerik:RadComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
                <Label Text="{Binding .}"
                       HorizontalTextAlignment="Justify"/>
            </DataTemplate>
        </telerik:RadComboBox.ItemTemplate>
    </telerik:RadComboBox>
</ContentView>
