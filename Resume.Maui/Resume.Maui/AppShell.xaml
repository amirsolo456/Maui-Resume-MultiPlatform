<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Resume.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mainpage="clr-namespace:Resume.Maui.Pages"
    xmlns:commonpages="clr-namespace:Resume.Maui.Pages.Login"
    Shell.FlyoutBehavior="Disabled"
    Title="Resume.Maui">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate mainpage:MainPage}"
        Route="MainPage" />
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate commonpages:LoginPage}"
        Route="LoginPage" />
</Shell>
