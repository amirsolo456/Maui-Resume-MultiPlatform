<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:telerik="http://schemas.telerik.com/2022/xaml/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Resume.Maui.Resources.Styles.BaseStyles">

    <Style x:Key="ButtonBaseStyle" TargetType="telerik:RadButton">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextTransform" Value="{OnPlatform Default=None, Android=Uppercase}" />
        <Setter Property="TextColor" Value="{DynamicResource CustomTextColor}" />
        <Setter Property="BorderColor" Value="{DynamicResource CustomBorderColor100}" />
        <Setter Property="Padding" Value="{OnPlatform Default='10', WinUI='24, 6', MacCatalyst='24, 4'}" />
    </Style>
    
    <Style TargetType="telerik:RadComboBox" 
           x:Key="CustomComboBaseStyle">

        <Setter Property="CornerRadius" Value="70"/>
        <Setter Property="BorderBrush" Value="{DynamicResource  CustomBorderColor100}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Gray950}, Dark={StaticResource Gray200}}" />
    </Style>
</ResourceDictionary>